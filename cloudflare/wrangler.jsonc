{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guike8-nightjar",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": false,
  "logpush": false,
  "build": {
    "command": "node scripts/build.mjs"
  },
  "vars": {
    "TRUST_CF_IP": "1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guike8-nightjar-events",
      "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 0,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false
    },
    "traces": {
      "enabled": false,
      "persist": false
    },
    "issues": {
      "enabled": false
    }
  }
}
